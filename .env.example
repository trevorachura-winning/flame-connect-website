# Flame Connect Website — environment contract
# Copy to .env.local. Never commit real secrets. Names only, no values.

# Public site URL used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://flameconnect.tech

# Website-only release (Nov 2026): no sign-in, no platform links and no
# server-side form handling. The former NEXT_PUBLIC_FLAME_OS_URL,
# NEXT_PUBLIC_FLAME_SALES_URL, NEXT_PUBLIC_FLAME_SALES_SIGNIN_PATH,
# LEAD_WEBHOOK_URL and LEAD_NOTIFICATION_EMAIL are no longer read and can be
# removed from Vercel. Public contact email/WhatsApp live in lib/site.ts.

# Optional analytics. No third-party script is loaded unless a measurement ID exists.
NEXT_PUBLIC_ANALYTICS_ID=
