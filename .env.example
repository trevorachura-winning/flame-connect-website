# Flame Connect Website — environment contract
# Copy to .env.local. Never commit real secrets. Names only, no values.

# Public site URL used for canonical URLs, sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://www.flameconnect.example

# Flame OS / product application origin — the SHARED platform layer. When set,
# it drives the site-wide "Explore Flame OS" CTA *and* every product launch
# button via productCtaHref(). Leave unset until the shared platform is deployed:
# pointing it at one product would repoint the other products' CTAs at it too.
# When unset, CTAs fall back to an on-site access request route so no public
# button can dead-end. See Appendix C — items requiring confirmation.
NEXT_PUBLIC_FLAME_OS_URL=

# Flame Sales platform origin — deployed app, confirmed Sept 2026. Kept separate
# from NEXT_PUBLIC_FLAME_OS_URL so wiring "Sign in" to Flame Sales cannot change
# where other products' CTAs point. Drives header + drawer "Sign in".
# Must be an absolute http(s) URL; a malformed value FAILS the build on purpose.
NEXT_PUBLIC_FLAME_SALES_URL=

# Auth path appended to the origin above for the "Sign in" link. Defaults to
# /login when unset. Set to /signin, /auth, / etc. to match the platform's own
# routing — no code change or redeploy of logic needed. `npm run platform:check`
# verifies the resulting URL resolves.
NEXT_PUBLIC_FLAME_SALES_SIGNIN_PATH=

# Where contact/enquiry submissions are delivered.
# If unset, submissions are validated and recorded in the server log only.
LEAD_WEBHOOK_URL=
LEAD_NOTIFICATION_EMAIL=

# Optional analytics. No third-party script is loaded unless a measurement ID exists.
NEXT_PUBLIC_ANALYTICS_ID=
